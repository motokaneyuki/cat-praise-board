<html>
    <body>
        <%= message %>
        <div>
            <% praises.map((praise) => { %>
                <p>"<%= praise.text %>"</p>
                <p>from <%= praise.user %></p>
                <p><%= praise.date %></p>
            <% }) %>
        </div>
        <nav>
            <a href="/new">send a praise</a>
        </nav>
    </body>
</html>