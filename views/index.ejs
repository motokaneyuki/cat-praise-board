<html>
    <body>
        <h1><%= message %></h1>
        <div>
            <% praises.forEach((praise) => { %>
                <p>"<%= praise.text %>"</p>
                <p>from <%= praise.user %></p>
                <p>sent <%= praise.date.toLocaleDateString() %></p>
                <hr>
            <% }) %>
        </div>
        <nav>
            <a href="/new">send a praise</a>
        </nav>
    </body>
</html>