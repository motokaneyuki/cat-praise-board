<html>
    <body>
        <h1><%= message %></h1>
        <div>
            <% praises.forEach((praise) => { %>
                <p>"<%= praise.text %>"</p>
                <p>from <%= praise.username %></p>
                <p>sent <%= praise.date.toLocaleDateString() %></p>
                <button><a href="/message/<%= praise.id %>">open</a></button>
                <button><a href="/update/<%= praise.id %>">update</a></button>
                <form action="/delete/<%= praise.id %>" method="POST" style="display:inline;">
                    <button type="submit" onclick="return confirm('are you sure you want to delete this praise?');">delete</button>
                </form>
                <hr>
            <% }) %>
        </div>
        <br>
        <nav>
            <a href="/new">send a praise</a>
        </nav>
        <br>
        <div>
            <form method="GET" action="/search">
                <label for="search">search user posts:</label>
                <input type="search" id="search" name="search" placeholder="enter name..">
                <button>search</button>
            </form>
        </div>
    </body>
</html>