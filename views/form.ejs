<html>
    <body>
        <h1>send a praise to the cutest cat in the world</h1>
        <form method="POST" action="/new">
            <div>
                <label for="name">name:</label>
                <input id="name" name="name" type="text">
            </div>
            <div>
                <label for="praise">message:</label>
                <input id="praise" name="praise" type="text">
